# Use production only on a live server behind HTTPS.
NODE_ENV=development
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=operations
MYSQL_USER=operations
MYSQL_PASSWORD=
# Docker Compose only; use a different password from MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
APP_URL=http://localhost:3000
HOST=127.0.0.1
UPLOAD_DIR=private-uploads
# Generate a separate secret for Contract Manager HMAC signatures.
CONTRACT_WEBHOOK_SECRET=
# Initial fallback only; saved Email delivery settings take precedence.
EMAIL_DELIVERY_ENABLED=false
